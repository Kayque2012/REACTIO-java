{
  "openapi": "3.1.0",
  "info": {
    "title": "REACTIO API",
    "description": "Sprint 1. CRUD editorial e quiz. Editorial sem autenticação: demonstração acadêmica local.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Quiz",
      "description": "Desafios sem gabarito e feedback após responder. Tentativas não são persistidas."
    },
    {
      "name": "Editorial",
      "description": "CRUD com gabarito. Sem autenticação nesta demonstração local."
    }
  ],
  "paths": {
    "/api/afirmacoes/{id}": {
      "get": {
        "tags": [
          "Editorial"
        ],
        "summary": "Consultar conteúdo editorial completo",
        "operationId": "consultar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID positivo",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Afirmação com gabarito e fonte",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AfirmacaoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Afirmação inexistente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Editorial"
        ],
        "summary": "Substituir os dados de uma afirmação",
        "operationId": "atualizar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID positivo",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AfirmacaoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Afirmação atualizada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AfirmacaoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Afirmação inexistente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Editorial"
        ],
        "summary": "Excluir afirmação",
        "operationId": "excluir",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID positivo",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            },
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Excluída"
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Afirmação inexistente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz/{id}/respostas": {
      "post": {
        "tags": [
          "Quiz"
        ],
        "summary": "Responder e receber explicação e fonte",
        "description": "Sempre devolve o feedback. Não grava histórico, XP ou progresso.",
        "operationId": "responder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID positivo",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespostaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Acerto, classificação correta, explicação e referência",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Afirmação inexistente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/afirmacoes": {
      "get": {
        "tags": [
          "Editorial"
        ],
        "summary": "Listar ou pesquisar conteúdo editorial",
        "description": "Busca parcial no enunciado, sem distinguir maiúsculas. Texto vazio lista tudo; ordem crescente e ID como desempate.",
        "operationId": "listar",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "description": "Trecho do enunciado, até 100 caracteres",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            },
            "example": "radiação"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de afirmações, possivelmente vazia",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AfirmacaoResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Editorial"
        ],
        "summary": "Cadastrar afirmação com explicação e referência",
        "operationId": "criar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AfirmacaoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Criada; Location aponta para a consulta",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AfirmacaoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz": {
      "get": {
        "tags": [
          "Quiz"
        ],
        "summary": "Listar desafios sem gabarito",
        "description": "Busca parcial no enunciado. Ordem crescente e ID como desempate.",
        "operationId": "listar_1",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "description": "Trecho do enunciado, até 100 caracteres",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            },
            "example": "radiação"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de desafios, possivelmente vazia",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DesafioResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/quiz/{id}": {
      "get": {
        "tags": [
          "Quiz"
        ],
        "summary": "Consultar desafio sem gabarito",
        "operationId": "consultar_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID positivo",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Enunciado, tema e ordem",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DesafioResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados ou parâmetros inválidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Afirmação inexistente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AfirmacaoRequest": {
        "type": "object",
        "properties": {
          "enunciado": {
            "type": "string",
            "example": "Toda radiação tem origem artificial.",
            "maxLength": 400,
            "minLength": 0
          },
          "tema": {
            "type": "string",
            "example": "Radiação no cotidiano",
            "maxLength": 80,
            "minLength": 0
          },
          "classificacao": {
            "type": "string",
            "enum": [
              "VERDADEIRO",
              "FALSO",
              "DEPENDE"
            ],
            "example": "FALSO"
          },
          "explicacao": {
            "type": "string",
            "example": "Existem fontes naturais, como os raios cósmicos e minerais do solo.",
            "maxLength": 1500,
            "minLength": 0
          },
          "referenciaTitulo": {
            "type": "string",
            "example": "EPA - Radiation Sources and Doses",
            "maxLength": 200,
            "minLength": 0
          },
          "referenciaUrl": {
            "type": "string",
            "example": "https://www.epa.gov/radiation/radiation-sources-and-doses",
            "maxLength": 500,
            "minLength": 0
          },
          "ordem": {
            "type": "integer",
            "format": "int32",
            "description": "Posição na trilha; empates são ordenados pelo ID.",
            "example": 10
          }
        },
        "required": [
          "classificacao",
          "enunciado",
          "explicacao",
          "ordem",
          "referenciaTitulo",
          "referenciaUrl",
          "tema"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "mensagem": {
            "type": "string"
          },
          "caminho": {
            "type": "string"
          },
          "campos": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AfirmacaoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "enunciado": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "classificacao": {
            "type": "string",
            "enum": [
              "VERDADEIRO",
              "FALSO",
              "DEPENDE"
            ]
          },
          "explicacao": {
            "type": "string"
          },
          "referenciaTitulo": {
            "type": "string"
          },
          "referenciaUrl": {
            "type": "string"
          },
          "ordem": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RespostaRequest": {
        "type": "object",
        "properties": {
          "resposta": {
            "type": "string",
            "enum": [
              "VERDADEIRO",
              "FALSO",
              "DEPENDE"
            ],
            "example": "FALSO"
          }
        },
        "required": [
          "resposta"
        ]
      },
      "FeedbackResponse": {
        "type": "object",
        "properties": {
          "afirmacaoId": {
            "type": "integer",
            "format": "int64"
          },
          "acertou": {
            "type": "boolean"
          },
          "respostaEnviada": {
            "type": "string",
            "enum": [
              "VERDADEIRO",
              "FALSO",
              "DEPENDE"
            ]
          },
          "classificacaoCorreta": {
            "type": "string",
            "enum": [
              "VERDADEIRO",
              "FALSO",
              "DEPENDE"
            ]
          },
          "explicacao": {
            "type": "string"
          },
          "referenciaTitulo": {
            "type": "string"
          },
          "referenciaUrl": {
            "type": "string"
          }
        }
      },
      "DesafioResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "enunciado": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "ordem": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}